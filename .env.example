# Copia este archivo a .env (local) y rellénalo. En Vercel, define las mismas variables
# en Settings → Environment Variables. NUNCA subas el .env real a Git.

# ── Vercel Blob (almacén privado) ──
BLOB_STORE_ID="store_xxxxxxxxxxxx"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# ── Firebase: configuración WEB (Configuración del proyecto → Tus apps → Web) ──
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy-ejemplo-falso"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="mi-proyecto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="mi-proyecto"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="mi-proyecto.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"

# ── Firebase Admin SDK (Cuentas de servicio → Generar nueva clave privada). SOLO SERVIDOR ──
FIREBASE_ADMIN_PROJECT_ID="mi-proyecto"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@mi-proyecto.iam.gserviceaccount.com"
# Los saltos de línea de la clave van escritos como \n
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE-ejemplo-falso\n-----END PRIVATE KEY-----\n"

# ── Quién puede iniciar sesión (correos separados por comas; sin esta variable nadie entra) ──
USUARIOS_PERMITIDOS="persona@ejemplo.com"

# ── DeepSeek (opcional; el generador de facturas no lo usa) ──
DEEPSEEK_API_KEY="sk-ejemplo-falso"
